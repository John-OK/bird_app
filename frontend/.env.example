# Vite Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# Thunder Forest Maps API Key
# Sign up at: https://www.thunderforest.com/
# IMPORTANT: Use domain restrictions in Thunder Forest dashboard to limit key usage to your domain
# Note: This key will be visible in browser - use domain restrictions for security
VITE_THUNDER_FOREST_API_KEY=your_thunder_forest_api_key_here