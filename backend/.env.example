# Django Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# Environment: "dev" or "prod"
env=dev

# IP Geolocation Services (for fallback when browser geolocation fails)
# Sign up at: https://www.iplocate.io/
IPLOCATE_API_KEY=your_iplocate_api_key_here

# Fallback #1: https://ipgeolocation.io/
IPGEOLOCATION_API_KEY=your_ipgeolocation_api_key_here

# Fallback #2: https://www.abstractapi.com/
ABSTRACT_API_KEY=your_abstract_api_key_here

# Xeno-Canto API (optional - for bird call data)
# Sign up at: https://xeno-canto.org/
XC_API_KEY=your_xeno_canto_api_key_here

# Thunder Forest Maps (currently unused, for future map tile options)
# Sign up at: https://www.thunderforest.com/
THUNDER_FOREST_API_KEY=your_thunder_forest_api_key_here